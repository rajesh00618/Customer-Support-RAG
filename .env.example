# OpenAI (for submission — uncomment and fill):
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMBEDDING_MODEL=text-embedding-3-small
# GENERATION_MODEL=gpt-4o-mini

# NVIDIA (for development — uncomment and fill):
# OPENAI_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# GENERATION_MODEL=openai/gpt-oss-20b

# Notes:
# - GENERATION_MODEL: openai/gpt-oss-20b is a small MoE model (20B total / ~3.6B active)
#   with fast latency and reliable JSON mode on the NVIDIA endpoint. It is used for intent
#   classification, response generation, and LLM-as-a-judge evaluation alike.
# - Chunks.embedding is an unconstrained `vector` column, so any embedding model
#   dimensionality (e.g. 2048 for NVIDIA, 1536 for OpenAI) works without migration.

DATABASE_URL=postgresql://postgres:password@localhost:5432/intellisupport
CHUNK_SIZE=512
CHUNK_OVERLAP=50
HYBRID_ALPHA=0.7
TOP_K=5
